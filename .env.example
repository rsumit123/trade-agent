# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ──────────────────────────────────────────────
# Default: OpenRouter (access to all models with one key)
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: use Anthropic directly instead
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: use OpenAI directly instead
# OPENAI_API_KEY=your_openai_api_key_here

# ── Model Selection (via OpenRouter) ──────────────────────────
# Default is Claude Sonnet. Other options:
#   anthropic/claude-opus-4-6
#   openai/gpt-4o
#   google/gemini-pro-1.5
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ── Agent Settings (optional overrides) ───────────────────────
# LLM_PROVIDER=openrouter     # "openrouter" (default), "anthropic", or "openai"
# INITIAL_CAPITAL=1000000     # Starting paper-trade capital in INR
# MAX_POSITION_PCT=0.20       # Max % of portfolio per position
# DAILY_LOSS_LIMIT_PCT=0.02   # Stop trading if daily loss exceeds this

# ── LLM Tracing (optional) ────────────────────────────────────
# When both keys are set, every decision cycle is traced to Langfuse:
# prompts, responses, tool calls, token usage, grouped by session.
# Leave unset to disable tracing entirely (zero overhead).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com
# LANGFUSE_SAMPLE_RATE=1.0                       # 0.0–1.0, lower to save quota
