# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ──────────────────────────────────────────────
# Required: get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: only needed if switching LLM_PROVIDER to "openai"
# OPENAI_API_KEY=your_openai_api_key_here

# ── Agent Settings (optional overrides) ───────────────────────
# LLM_PROVIDER=anthropic       # "anthropic" or "openai"
# INITIAL_CAPITAL=1000000      # Starting paper-trade capital in INR
# MAX_POSITION_PCT=0.20        # Max % of portfolio per position
# DAILY_LOSS_LIMIT_PCT=0.02    # Stop trading if daily loss exceeds this
